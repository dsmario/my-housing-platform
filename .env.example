# Local sign-in settings for docker compose. Copy to .env and fill in.
# Values come from: cd terraform/identity && terraform output
# (web_client_secret: terraform output -raw web_client_secret)
AUTH_SECRET=            # any long random string, e.g. from: openssl rand -base64 33
AUTH_COGNITO_ID=        # web_client_id
AUTH_COGNITO_SECRET=    # web_client_secret
AUTH_COGNITO_ISSUER=    # users_issuer
AUTH_COGNITO_DOMAIN=    # login_domain
